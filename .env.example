# Copy to .env and fill in values. docker compose reads this automatically.

# Session signing key. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is generated at startup (sessions reset on restart).
SECRET_KEY=

# AI import (any OpenAI-compatible API). Defaults target OpenRouter.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Optional: Bright Data MCP endpoint for fetching bot-protected product pages (Amazon, etc.)
# e.g. https://mcp.brightdata.com/mcp?token=YOUR_TOKEN
BRIGHTDATA_MCP_URL=

# SQLite database file location (inside container this is /data/filaman.db)
#DB_PATH=./data/filaman.db

# Host port to publish the app on (container always listens on 8000)
#FILAMAN_PORT=8000

# Optional, one-time: when upgrading a single-user database, move the existing
# inventory to a NEW user with this name (same password as the existing account);
# the existing account keeps the admin role. Leave empty to keep data on the
# existing account.
FILAMAN_LEGACY_OWNER=
